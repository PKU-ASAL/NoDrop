#ifndef CONFIG_H_
#define CONFIG_H_

#define Kib 1024
#define Mib 1024 * Kib

#ifndef KERNEL_VERSION
#define KERNEL_VERSION(a, b, c) (((a) << 16) + ((b) << 8) + (c))
#endif

#define CONFIG_BUFFER_SIZE ${BUFFER_SIZE}
#define CONFIG_MONITOR_PATH "${MONITOR_PATH}"
#define CONFIG_STORE_PATH "${STORE_PATH}"
#define CONFIG_MONITOR_STACK_SIZE ${STACK_SIZE}
#define CONFIG_KERNEL_VERSION_MAJOR ${CONFIG_KERNEL_VERSION_MAJOR}
#define CONFIG_KERNEL_VERSION_MINOR ${CONFIG_KERNEL_VERSION_MINOR}
#define CONFIG_KERNEL_VERSION_PATCH ${CONFIG_KERNEL_VERSION_PATCH}
#define CONFIG_LINUX_VERSION_CODE ${CONFIG_LINUX_VERSION_CODE}

#if CONFIG_BUFFER_SIZE < PAGE_SIZE
  #error "Buffer size is smaller than a page"
#endif

#if CONFIG_MONITOR_STACK_SIZE < PAGE_SIZE
  #error "Stack size is smaller than a page"
#endif

#endif //CONFIG_H_
